FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN npm install -g corepack@latest \
    && corepack pnpm install \
    && python3 -m venv /opt/carvalue-venv \
    && /opt/carvalue-venv/bin/pip install --no-cache-dir joblib pandas scikit-learn==1.6.1

ENV PATH="/opt/carvalue-venv/bin:${PATH}"
ENV NODE_ENV=production
ENV PYTHON_BIN=/opt/carvalue-venv/bin/python

RUN corepack pnpm run build

CMD ["node", "dist/index.js"]
